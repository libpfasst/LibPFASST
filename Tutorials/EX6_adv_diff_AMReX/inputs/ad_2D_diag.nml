!
!  Test parameters for a 2-D advection diffusion
!	du_dt = -vx * du_dx -vy * du_dy + nu * (du_dxx + du_dyy)
!

&PF_PARAMS
   !  These are internal pfasst variables that must be set
    nlevels = 1	

    !  These are internal pfasst variables that can be reset
    niters = 5   !  default is 5
    
     !  Type of quadrature nodes (default is 1=Gauss-Lobatto)
     qtype   = 1 
     nnodes = 4
	
     !  optional variables to control termination  (defaults are 0.0)
     abs_res_tol = 0.d0
     rel_res_tol = 0.d0

     
     ! predictor options
     nsweeps_pred= 1 
     Pipeline_pred =  .true.
     PFASST_pred = .false. 
     
     ! run options
     nsweeps= 1
     Vcycle=.false.

    !
    debug = .false.
    !outdir = 'AD_2D'
     
/

!  Now define the local variables you need
&PARAMS

    nspace = 4
    ntime = 1
    ndiag = 3

    nx = 16
    ny = 16
    max_grid_size = 8     ! maximum number of points per dim - generate boxarray from domain-box

    nu = 0.02       ! default = 0.02
    vx = 1.0         ! default = 1.0
    vy = 1.0         ! default = 1.0
    
    Lx = 1.0
    Ly = 1.0
    Lz = 0.0
    
    Tfin = 0.4              
    nsteps = 4              ! 16
    ic_type = 1             ! 1 -> Sin-wave
    kfreqx = 1.0
    kfreqy = 2.0

    ! controls splitting (0 fully implicit, 1 treats u_xx implicitly and u_x explicitly, 2 fully explicit)
    splitting = 1

    ! AMReX general and MLMG solver options
    mlmg_max_iter       =       10       ! maximum number of iterations for MLMG solver
    mlmg_tol_rel        =   1.d-14       ! relative tolerance for MLMG solver
    mlmg_tol_abs        =   1.d-14       ! absolute tolerance for MLMG solver
    linop_maxorder      =        2       ! order of stencil for Laplacian
    linop_bc_lo         =      200 200   ! array size of dimension           
    linop_bc_hi         =      200 200   ! array size of dimension
        ! LinOpBCType :: Integer
        !     interior         =    0
        !     Dirichlet        =  101
        !     Neumann          =  102
        !     reflect_odd      =  103
        !     Marshak          =  104
        !     SanchezPomraning =  105
        !     inflow           =  106
        !     inhomogNeumann   =  107
        !     Robin            =  108
        !     symmetry         =  109
        !     Periodic         =  200
        !     bogus            = 1729
    geom_bc_lo  = 0 0                     ! array size of dimension
    geom_bc_hi  = 0 0                     ! array size of dimension
        !     amrex_bc_bogus        = -666
        !     amrex_bc_reflect_odd  = -1
        !     amrex_bc_int_dir      =  0
        !     amrex_bc_reflect_even =  1
        !     amrex_bc_foextrap     =  2
        !     amrex_bc_ext_dir      =  3
        !     amrex_bc_hoextrap     =  4
        !     amrex_bc_hoextrapcc   =  5
        !     amrex_bc_ext_dir_cc   =  6
/
