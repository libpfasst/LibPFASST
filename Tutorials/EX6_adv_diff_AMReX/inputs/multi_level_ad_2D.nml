!
!  Test parameters for a 2-D advection diffusion
!	du_dt = -vx * du_dx -vy * du_dy + nu * (du_dxx + du_dyy)
!

&PF_PARAMS
    nlevels  = 2   !  must be set

    niters = 15   !  default is 5
    nnodes = 3 5  

    !  Type of quadrature nodes (default is 1=Gauss-Lobatto)
    qtype  = 1   
   
     !  optional variables to control termination  (defaults are 0.0)
     abs_res_tol = 0.d0
     rel_res_tol = 0.d0


     !  Variable which determine how the predictor runs  (default is .false. and .true.)
     pipeline_pred =  .true.
     PFASST_pred = .true.
     nsweeps_pred= 1
    
     !  Variable to tell if Vcycling will be done.  Here PFASST vcycles
     Vcycle=.TRUE.
     nsweeps= 1 1
    

     !
     debug = .false.
     !outdir = 'AD_2Level_2D'
/

!  Now define the local variables you need
&PARAMS

    ntime = 1
    nspace = 8

    nx = 64 128
    ny = 96 192
    max_grid_size = 16     ! maximum number of points per dim - generate boxarray from domain-box

    nu = 0.02       ! default = 0.02
    vx = 1.0         ! default = 1.0
    vy = 0.6         ! default = 1.0
    
    !Lx=6.28318530717958647692528676655900576839433879875021
    Lx = 2.0
    Ly = 3.0
    Lz = 0.0
    
    Tfin = 0.2              
    nsteps = 2              ! 16
    eq_type = 1             ! 1 -> adv-diff	
    ic_type = 1             ! 1 -> Sin-wave
    kfreqx = 1.0
    kfreqy = 2.0

    ! controls splitting (0 fully implicit, 1 treats u_xx implicitly and u_x explicitly, 2 fully explicit)
    splitting = 1

    ! AMReX general and MLMG solver options
    mlmg_max_iter       =       10       ! maximum number of iterations for MLMG solver
    mlmg_tol_rel        =   1.d-10       ! relative tolerance for MLMG solver
    mlmg_tol_abs        =   1.d-12       ! absolute tolerance for MLMG solver
    linop_maxorder      =        2       ! order of stencil for Laplacian
    linop_bc_lo         =      200 200   ! array size of dimension           
    linop_bc_hi         =      200 200   ! array size of dimension
        ! LinOpBCType :: Integer
        !     interior         =    0
        !     Dirichlet        =  101
        !     Neumann          =  102
        !     reflect_odd      =  103
        !     Marshak          =  104
        !     SanchezPomraning =  105
        !     inflow           =  106
        !     inhomogNeumann   =  107
        !     Robin            =  108
        !     symmetry         =  109
        !     Periodic         =  200
        !     bogus            = 1729
    geom_bc_lo  = 0 0                     ! array size of dimension
    geom_bc_hi  = 0 0                     ! array size of dimension
        !     amrex_bc_bogus        = -666
        !     amrex_bc_reflect_odd  = -1
        !     amrex_bc_int_dir      =  0
        !     amrex_bc_reflect_even =  1
        !     amrex_bc_foextrap     =  2
        !     amrex_bc_ext_dir      =  3
        !     amrex_bc_hoextrap     =  4
        !     amrex_bc_hoextrapcc   =  5
        !     amrex_bc_ext_dir_cc   =  6
/
