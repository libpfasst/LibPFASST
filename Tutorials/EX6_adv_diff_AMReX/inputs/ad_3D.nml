!
!  Test parameters for a 3-D advection diffusion
!	du_dt = -vx * du_dx -vy * du_dy -vz * du_dz + nu * (du_dxx + du_dyy + du_dzz)
!

&PF_PARAMS
   !  These are internal pfasst variables that must be set
    nlevels = 1	

    !  These are internal pfasst variables that can be reset
    niters = 4   !  default is 5
     
     !  Type of quadrature nodes (default is 1=Gauss-Lobatto)
     qtype   = 2 
     nnodes = 5
	 
     !  optional variables to control termination  (defaults are 0.0)
     abs_res_tol = 0.d0
     rel_res_tol = 0.d0

     ! predictor options
     nsweeps_pred= 1 
     Pipeline_pred =  .true.
     PFASST_pred = .false. 
     
     ! run options
     nsweeps= 1
     Vcycle=.false.

     !
     debug = .false.
     !outdir = 'AD_3D'

     
/

!  Now define the local variables you need
&PARAMS
    
    ! ATTENTION: user must make sure that nprocs = ntime * nspace holds!
    ntime = 2       ! number of processes in time     
    nspace = 8     ! number of processes in space

    nx = 64
    ny = 64
    nz = 64
    max_grid_size = 32     ! maximum number of points per dim - generate boxarray from domain-box

    nu = 0.02       ! default = 0.02
    vx = 1.0         ! default = 1.0
    vy = 0.6         ! default = 1.0
    vz = 0.4         ! default = 1.0
    
    !Lx=6.28318530717958647692528676655900576839433879875021
    Lx = 2.0
    Ly = 3.0
    Lz = 2.0
    
    Tfin = 0.5              
    nsteps = 8              ! 16
    eq_type = 1             ! 1 -> adv-diff	
    ic_type = 1             ! 1 -> Sin-wave
    kfreqx = 1.0
    kfreqy = 2.0
    kfreqz = 1.0

    ! controls splitting (0 fully implicit, 1 treats u_xx implicitly and u_x explicitly, 2 fully explicit)
    splitting = 1

    ! AMReX general and MLMG solver options
    mlmg_max_iter       =       10       ! maximum number of iterations for MLMG solver
    mlmg_tol_rel        =   1.d-10       ! relative tolerance for MLMG solver
    mlmg_tol_abs        =   1.d-12       ! absolute tolerance for MLMG solver
    linop_maxorder      =        2       ! order of stencil for Laplacian
    linop_bc_lo         =      200 200 200   ! array size of dimension           
    linop_bc_hi         =      200 200 200   ! array size of dimension
        ! LinOpBCType :: Integer
        !     interior         =    0
        !     Dirichlet        =  101
        !     Neumann          =  102
        !     reflect_odd      =  103
        !     Marshak          =  104
        !     SanchezPomraning =  105
        !     inflow           =  106
        !     inhomogNeumann   =  107
        !     Robin            =  108
        !     symmetry         =  109
        !     Periodic         =  200
        !     bogus            = 1729
    geom_bc_lo  = 0 0 0                     ! array size of dimension
    geom_bc_hi  = 0 0 0                     ! array size of dimension
        !     amrex_bc_bogus        = -666
        !     amrex_bc_reflect_odd  = -1
        !     amrex_bc_int_dir      =  0
        !     amrex_bc_reflect_even =  1
        !     amrex_bc_foextrap     =  2
        !     amrex_bc_ext_dir      =  3
        !     amrex_bc_hoextrap     =  4
        !     amrex_bc_hoextrapcc   =  5
        !     amrex_bc_ext_dir_cc   =  6
/
